export default async function handler(req, res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Cache-Control', 'no-store');
  const { GITHUB_TOKEN, ADMIN_PASSWORD } = process.env;
  const REPO = 'kobulai/kobulai';
  try {
    const r = await fetch(`https://api.github.com/repos/${REPO}/contents/recommendations.json`, {
      headers: { Authorization: `Bearer ${GITHUB_TOKEN}`, Accept: 'application/vnd.github+json' },
    });
    const { content } = await r.json();
    const data = JSON.parse(Buffer.from(content, 'base64').toString('utf8'));
    if (req.query?.full === '1' && req.query?.password === ADMIN_PASSWORD) {
      return res.status(200).json(data);
    }
    return res.status(200).json({ latest: data.latest || null, approved: data.approved || [] });
  } catch(e) {
    return res.status(200).json({ latest: null });
  }
}
